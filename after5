#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["git-filter-repo"]
# ///
"""
😼 Rewrite git history so commits land outside 9-5 workday in local timezone.
Examples:
    # Rewrite history (git-filter-repo recommends always running on a fresh clone)
    after5

    # Preview what would be shifted
    after5 --dry-run

    # Override default no-no zone
    after5 --work-start 10:00 --work-end 18:00 --dry-run

    # Snipe rewrite a small window (e.g. you were travelling and had a different schedule)
    after5 --after 2026-05-01 --before 2026-06-01

    # Option to independently rewrite name and email info (e.g. you have a different git profile)
    after5 --name sneaky --email beaky@goodemployee.com
"""
import argparse
import os
import subprocess
import sys
from datetime import date, datetime, timedelta, timezone
from pathlib import Path

import tomllib

try:
    import git_filter_repo as fr
except ImportError:
    sys.exit("git-filter-repo not found: something is terribly wrong")


CommitHash = str
UtcTimestamp = int
ShiftMap = dict[CommitHash, UtcTimestamp]


def _day_secs(dt: datetime) -> int:
    return dt.hour * 3600 + dt.minute * 60 + dt.second


def _parse_hhmm(s: str) -> int:
    try:
        h, m = s.split(":")
        return int(h) * 3600 + int(m) * 60
    except (ValueError, AttributeError):
        raise SystemExit(f"Invalid time '{s}': expected HH:MM")


def _parse_utc_offset(offset_str: str) -> int:
    sign = 1 if offset_str[0] == "+" else -1
    return sign * (int(offset_str[1:3]) * 3600 + int(offset_str[3:5]) * 60)


def _git_dir(repo_path: str) -> Path:
    result = subprocess.run(
        ["git", "-C", repo_path, "rev-parse", "--git-dir"],
        capture_output=True, text=True, check=True,
    )
    gd = result.stdout.strip()
    p = Path(gd)
    return p if p.is_absolute() else (Path(repo_path).resolve() / p).resolve()


def project_timestamp(local_day_secs: int, midnight: int, work_start: int, work_end: int, day_end: int) -> int:
    target_start = work_end + 1
    scale = (day_end - target_start) / (day_end - work_start)
    return midnight + target_start + int((local_day_secs - work_start) * scale)


def collect_commits(repo_path: str, after: str | None = None, before: str | None = None) -> dict[CommitHash, datetime]:
    cmd = ["git", "-C", repo_path, "log", "--format=%H %ad", "--date=raw"]
    if after:
        cmd.append(f"--since={after}")
    if before:
        cmd.append(f"--until={before}")

    result = subprocess.run(cmd, capture_output=True, text=True, check=True)

    commits = {}
    for line in result.stdout.splitlines():
        if not line.strip():
            continue
        commit_hash, ts_str, offset_str = line.split()
        ts = int(ts_str)
        tz = timezone(timedelta(seconds=_parse_utc_offset(offset_str)))
        commits[commit_hash] = datetime.fromtimestamp(ts, tz=tz)

    return commits


def build_shift_map(
    commits: dict[CommitHash, datetime],
    work_end: int = 17 * 3600,
    work_start: int = 9 * 3600,
    day_end: int = 24 * 3600,
    skip_weekends: bool = True,
) -> ShiftMap:
    # only redistribute days with >= 1 commit in work window
    targeted_days = set()
    for dt in commits.values():
        if (work_start <= _day_secs(dt) <= work_end) and not (skip_weekends and dt.weekday() >= 5):
            targeted_days.add(dt.date())

    shift_map: ShiftMap = {}
    for hash, dt in commits.items():
        if dt.date() not in targeted_days:
            continue

        ds = _day_secs(dt)
        if ds < work_start or ds >= day_end:
            continue

        midnight = int(dt.timestamp()) - ds
        shift_map[hash] = project_timestamp(ds, midnight, work_start, work_end, day_end)

    return shift_map


def _print_dry_run(commits: dict[CommitHash, datetime], shift_map: ShiftMap) -> None:
    if not shift_map:
        print("... so no history to rewrite? 🤨")
        return

    prev_day = None
    for hash, new_ts in sorted(shift_map.items(), key=lambda kv: commits[kv[0]]):
        dt = commits[hash]

        if dt.date() != prev_day:
            if prev_day is not None:
                print()
            print(dt.strftime("%a %b %-d, %Y"))
            prev_day = dt.date()

        offset_h = int((dt.utcoffset() or timedelta()).total_seconds() / 3600)
        tz_label = f"UTC{'+' if offset_h >= 0 else ''}{offset_h}"

        old = dt.strftime("%-I:%M %p")
        new = datetime.fromtimestamp(new_ts, tz=dt.tzinfo).strftime("%-I:%M %p")
        print(f"  {hash[:8]}  {old} ({tz_label})  →  {new} ({tz_label})")


def _replace_timestamp(date: bytes, new_ts: int) -> bytes:
    # keep tz offset, replace utc seconds
    _, offset_str = date.decode().split()
    return f"{new_ts} {offset_str}".encode()


def make_callback(shift_map: ShiftMap, name: str | None, email: str | None):
    def commit_callback(commit, metadata):
        commit_hash = commit.original_id.decode()
        if commit_hash in shift_map:
            new_ts = shift_map[commit_hash]
            commit.author_date = _replace_timestamp(commit.author_date, new_ts)
            commit.committer_date = _replace_timestamp(commit.committer_date, new_ts)

        if name:
            commit.author_name = commit.committer_name = name.encode()
        if email:
            commit.author_email = commit.committer_email = email.encode()

    return commit_callback


def _write_config(git_dir: Path, work_start: int, work_end: int, day_end: int, skip_weekends: bool, name: str | None, email: str | None) -> None:
    (git_dir / "after5.toml").write_text(
        f"work_start = {work_start}\n"
        f"work_end = {work_end}\n"
        f"day_end = {day_end}\n"
        f"skip_weekends = {'true' if skip_weekends else 'false'}\n"
        + (f"name = {name}\n" if name else "")
        + (f"email = {email}\n" if email else "")
    )


def _read_config(git_dir: Path) -> dict:
    config_path = git_dir / "after5.toml"
    if not config_path.exists():
        sys.exit(f"after5: no config at {config_path} (° ‸ °)? rerun after5 to try and recreate the config")

    with open(config_path, "rb") as f:
        return tomllib.load(f)


def _install_hook(git_dir: Path) -> None:
    hook_path = git_dir / "hooks" / "post-commit"
    call_line = "after5 --amend-head\n"

    if hook_path.exists():
        existing = hook_path.read_text()
        if "after5 --amend-head" in existing:
            return

        hook_path.write_text(existing.rstrip("\n") + "\n" + call_line)

    else:
        hook_path.write_text("#!/usr/bin/env bash\n" + call_line)
        hook_path.chmod(0o755)


def amend_head(repo_path: str) -> None:
    git_dir = _git_dir(repo_path)
    lock = git_dir / "AFTER5_AMENDING"

    if lock.exists():
        return

    cfg = _read_config(git_dir)
    work_start = cfg["work_start"]
    work_end = cfg["work_end"]
    day_end = cfg["day_end"]
    skip_weekends = cfg["skip_weekends"]
    name = cfg.get("name")
    email = cfg.get("email")

    result = subprocess.run(
        ["git", "-C", repo_path, "log", "-1", "--format=%ad %H", "--date=raw"],
        capture_output=True, text=True, check=True,
    )
    line = result.stdout.strip()
    if not line:
        return

    ts_str, offset_str, _ = line.split()
    ts = int(ts_str)
    tz = timezone(timedelta(seconds=_parse_utc_offset(offset_str)))
    dt = datetime.fromtimestamp(ts, tz=tz)

    if skip_weekends and dt.weekday() >= 5:
        return

    ds = _day_secs(dt)
    if ds < work_start:
        return

    midnight = ts - ds
    new_ts = project_timestamp(ds, midnight, work_start, work_end, day_end)
    new_date = f"{new_ts} {offset_str}"

    lock.touch()
    try:
        cmd = [
            "git", "-C", repo_path, "commit", "--amend", "--no-edit",
            f"--date={new_date}",
        ]
        if name and email:
            cmd.append(f"--author={name} <{email}>")

        subprocess.run(cmd, env={**os.environ, "GIT_COMMITTER_DATE": new_date}, check=True)
    finally:
        lock.unlink()


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument(
        "repo", nargs="?", default=".",
        help="path to target git repo (default current directory)"
    )
    p.add_argument(
        "--amend-head", action="store_true",
        help="project HEAD commit timestamp into after-hours range (used by post-commit hook)"
    )
    p.add_argument(
        "--dry-run", action="store_true",
        help="print commits that would be shifted without rewriting history"
    )
    p.add_argument(
        "--work-end", default="17:00",
        help="defines end of work day — commits in work day get shifted after it (HH:MM, default 17:00)"
    )
    p.add_argument(
        "--work-start", default="09:00",
        help="defines start of work day — commits before this aren't touched (HH:MM, default 09:00)"
    )
    p.add_argument(
        "--name",
        help="replace author/committer name"
    )
    p.add_argument(
        "--email",
        help="replace author/committer email"
    )
    p.add_argument(
        "--after",
        help="only target commits after this date, exclusive (YYYY-MM-DD)"
    )
    p.add_argument(
        "--before",
        help="only target commits before this date, inclusive (YYYY-MM-DD, default: yesterday)"
    )
    p.add_argument(
        "--day-end", default="24:00",
        help="exclusive end of day for timestamp redistribution (HH:MM, default 24:00, same as 00:00 next day)"
    )
    p.add_argument(
        "--skip-weekends", action="store_true",
        help="option to rewrite weekend commits (default ignore weekends)"
    )
    args = p.parse_args()

    # hook path
    if args.amend_head:
        amend_head(args.repo)
        return

    work_end = _parse_hhmm(args.work_end)
    work_start = _parse_hhmm(args.work_start)
    day_end = _parse_hhmm(args.day_end)

    before = args.before or (date.today() - timedelta(days=1)).isoformat()
    commits = collect_commits(args.repo, after=args.after, before=before)
    shift_map = build_shift_map(
        commits,
        work_end=work_end,
        work_start=work_start,
        day_end=day_end,
        skip_weekends=args.skip_weekends,
    )

    if args.dry_run:
        _print_dry_run(commits, shift_map)
        return

    fr_args = fr.FilteringOptions.parse_args(["--force", "--repo", args.repo])
    fr.RepoFilter(fr_args, commit_callback=make_callback(shift_map, args.name, args.email)).run()

    git_dir = _git_dir(args.repo)
    _write_config(
        git_dir,
        work_start,
        work_end,
        day_end,
        args.skip_weekends,
        args.name,
        args.email
    )
    _install_hook(git_dir)
    print(f"after5: hook installed at {git_dir / 'hooks' / 'post-commit'}")


if __name__ == "__main__":
    main()
